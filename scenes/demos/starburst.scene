[expect]
// a full shell of stars is in flight on the first burst
after 200: particles >= 150
// the crescendo and the finale fill the sky with stars
after 1260: particles >= 600
after 1420: particles >= 600
// no brick or torch is lost: the fireworks do not damage the town
after 1699: count brick in 0 -440 960 100 == 46480
after 1699: count torch in 0 -440 960 100 == 1742
// the hillside is not gouged, and spent stars do not pile up in the town
after 1699: count soil in 0 -440 960 100 == 36616
after 1699: count shards in 0 -110 960 100 <= 150
after 1699: count rubble in 0 -110 960 100 <= 60
after 1699: count basalt in 0 -110 960 100 <= 40

