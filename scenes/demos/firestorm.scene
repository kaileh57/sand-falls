// Firestorm: a forest on a hillside catches fire in a crosswind. Crowns flash,
// trunks burn down to smoking stumps, and where the burning willow and a log
// meet the water they hiss into steam: the fire front stops at the river.
[scene]
name = firestorm
description = A wind-driven fire sweeps a hillside forest; the fire front stops at the river.
size = 960 576
seed = 0xf12e
wind = 3
ticks = 2700

[build]
fill 0 540 960 576 bedrock
terrain 0 960 430 26 90 soil 540
terrain 0 960 470 14 60 stone 540
// The river.
fill 425 400 475 470 air
fill 425 440 475 470 water
// The left-bank forest: low, broad crowns on short trunks. A trunk burns down
// from its crown about two cells a second, so the first trees are ash long
// before the end, and the trees by the river, which catch last, stand taller
// so they are still smoking stumps when the scene ends.
