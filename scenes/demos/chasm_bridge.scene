[expect]
// The deck is stamped into the first frame.
after 1: count wood in 240 140 480 200 > 700
// Before the block drops the deck spans the chasm with the crate on it, and the
// bottle crate has burst into glass shards.
after 400: count wood in 300 120 420 250 > 350
after 400: count shards in 0 0 720 380 > 20
// The block lands mid-span and the centre hinge snaps: the middle is empty.
after 600: count wood in 300 120 420 250 < 200
// Both halves hang from their pins down the stack faces.
after 700: count wood in 240 150 280 284 > 250
after 700: count wood in 440 150 480 284 > 250
// The last charge drops the right half; the left one still hangs.
after 1000: count wood in 240 150 280 250 > 250
after 1000: count wood in 440 150 480 250 < 60
// The wreckage burns on the lava; the block's iron straps are left in it.
after 1259: count metal in 330 260 420 300 > 50
after 1259: count burning_wood in 240 230 480 300 >= 30
after 1259: count fire in 240 200 480 300 >= 20

