// Demolition: a 16 x 36 m brick tower with timber floors and glass windows
// (10 cells per metre), brought down in real time under real gravity.
//
// Charges are explode events, not packed explosives. Over about 2.5 s they cut
// the right wall and the right core on floors 1-3, then the left core on floor
// 1, then, half a second later, the left wall on floor 1. The right side loses
// three storeys and the left only one, so once the base is cut the tower comes
// free as one rigid body, drops onto its left stumps and pivots right. It
// shatters on the ground: small fragments near the impact, big slabs farther
// up the tower. A grey dust cloud rolls out over the ground, the oil-soaked
// timber floors and wooden crates catch fire inside the falling structure, and
// the scene ends on a smoking, burning pile.
[scene]
name = demolition
description = Staggered charges cut a brick tower's base; it tips right on its last wall, shatters into slabs and fragments, and burns in a cloud of dust.
size = 960 540
seed = 0xde30
ticks = 1500

[build]
fill 0 500 960 540 bedrock
terrain 0 960 470 6 120 soil 500
fill 300 440 660 500 concrete

// Floors 1-8: brick walls, timber columns and floor beams, a brick slab per
// floor, glass only in the window panes. Brick crown and glass top.
