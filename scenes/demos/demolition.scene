// Demolition: a 16 x 36 m brick tower with timber floors and glass windows
// (10 cells per metre), brought down in real time under real gravity.
//
// The charges are explode events; no explosive is packed in the build. Over
// about two seconds they cut the right wall and the right core on floors 1-3,
// then the left core on floor 1, then, half a second later, the left wall on
// floor 1. The right half of the tower has nothing under it for three storeys,
// so when the left wall goes the tower comes free as one rigid body (tick 215),
// drops two metres onto the stump of its left wall and pivots right into the
// gap. It takes about four seconds to lean past 45 degrees. Then a row of
// delayed charges on floors 4 and 6 fires (tick 445): they cut the falling
// tower in the air and push the sections apart. The sections hit the pad and
// the soil bank on the right and break up where they land, into small pieces
// at the impact and larger slabs further away, raising dust. The charges
// light the crates on floors 2-5 and the oil films on floors 1 and 2, the
// timber floors catch, and the scene ends on a smoking pile of burning and
// smouldering timber.
[scene]
name = demolition
description = Staggered charges cut a brick tower's base; it pivots right on its last wall, breaks into three sections in the air, shatters at the far end and burns.
size = 960 540
seed = 0xde30
ticks = 1500

[build]
fill 0 500 960 540 bedrock
terrain 0 960 470 6 120 soil 500
fill 300 440 880 500 concrete
// A soil bank on the right stops sliding wreckage before it leaves the world.
circle 1090 620 280 soil

// Floors 1-8: brick walls, timber columns and floor beams, a brick slab per
// floor, glass only in the window panes. A hollow brick plant room on the
// roof with a glass lantern on top.
fill 400 400 408 440 brick
fill 552 400 560 440 brick
fill 452 406 458 440 wood
fill 502 406 508 440 wood
fill 400 400 560 404 brick
fill 408 404 552 406 wood
fill 400 416 408 426 glass
fill 552 416 560 426 glass
fill 400 360 408 400 brick
fill 552 360 560 400 brick
fill 452 366 458 400 wood
fill 502 366 508 400 wood
fill 400 360 560 364 brick
fill 408 364 552 366 wood
fill 400 376 408 386 glass
fill 552 376 560 386 glass
fill 400 320 408 360 brick
fill 552 320 560 360 brick
fill 452 326 458 360 wood
fill 502 326 508 360 wood
fill 400 320 560 324 brick
fill 408 324 552 326 wood
fill 400 336 408 346 glass
fill 552 336 560 346 glass
fill 400 280 408 320 brick
fill 552 280 560 320 brick
fill 452 286 458 320 wood
fill 502 286 508 320 wood
fill 400 280 560 284 brick
fill 408 284 552 286 wood
fill 400 296 408 306 glass
fill 552 296 560 306 glass
fill 400 240 408 280 brick
fill 552 240 560 280 brick
fill 452 246 458 280 wood
fill 502 246 508 280 wood
fill 400 240 560 244 brick
fill 408 244 552 246 wood
fill 400 256 408 266 glass
fill 552 256 560 266 glass
fill 400 200 408 240 brick
fill 552 200 560 240 brick
fill 452 206 458 240 wood
fill 502 206 508 240 wood
fill 400 200 560 204 brick
fill 408 204 552 206 wood
fill 400 216 408 226 glass
fill 552 216 560 226 glass
fill 400 160 408 200 brick
fill 552 160 560 200 brick
fill 452 166 458 200 wood
fill 502 166 508 200 wood
fill 400 160 560 164 brick
fill 408 164 552 166 wood
fill 400 176 408 186 glass
fill 552 176 560 186 glass
fill 400 120 408 160 brick
fill 552 120 560 160 brick
fill 452 126 458 160 wood
fill 502 126 508 160 wood
fill 400 120 560 124 brick
fill 408 124 552 126 wood
fill 400 136 408 146 glass
fill 552 136 560 146 glass
fill 420 96 540 120 brick
fill 426 100 534 120 air
fill 460 76 500 96 glass

// Fuel: wooden crates and furniture (6-12 cell wood blocks) on floors 2-5,
// standing on the slab below, and a 2-row oil film on floors 1 and 2 under
// the left half of the tower, where the charges light them.
// floor 1 (ground, y 440)
fill 412 438 448 440 oil
// floor 2 (slab top y 400)
fill 414 392 424 400 wood
fill 428 394 436 400 wood
fill 470 390 482 400 wood
fill 520 392 530 400 wood
fill 438 398 468 400 oil
// floor 3 (slab top y 360)
fill 418 350 428 360 wood
fill 440 352 450 360 wood
fill 476 352 486 360 wood
fill 530 350 540 360 wood
// floor 4 (slab top y 320)
fill 412 312 424 320 wood
fill 468 310 478 320 wood
fill 484 314 494 320 wood
fill 526 312 538 320 wood
// floor 5 (slab top y 280)
fill 416 270 426 280 wood
fill 440 272 450 280 wood
fill 470 272 482 280 wood
fill 492 274 500 280 wood
fill 528 270 538 280 wood

[events]
// Right wall and right core on floors 1-3, a quarter second apart. The core
// charges sit at slab level, so they cut the floor slabs as well as the
// timber column, and nothing is left under the right half of the tower below
// floor 4.
at 90: explode 556 424 16 240
at 105: explode 505 410 16 220
at 120: explode 556 384 16 240
at 135: explode 505 370 16 220
at 150: explode 556 344 16 240
at 165: explode 505 338 14 220
// Left core on floor 1.
at 185: explode 455 422 14 220
// Left wall on floor 1, half a second later. The tower comes free, drops onto
// the stump of the left wall and pivots right into the three-storey gap.
at 215: explode 404 420 12 240
// Delayed charges, timed to the falling tower. At tick 445 it leans about 52
// degrees; these sit on its walls and timber columns at the floor 6 and
// floor 4 windows (building y 221 and y 301, moved with the tower's pose at
// that tick) and cut it into three sections.
at 445: explode 573 246 12 200
at 445: explode 605 286 12 200
at 445: explode 636 326 12 200
at 445: explode 667 366 12 200
at 445: explode 510 296 12 200
at 445: explode 542 336 12 200
at 445: explode 573 375 12 200
at 445: explode 604 415 12 200

[camera]
view 960 540
scale 2
sky dusk
ambient 0.12 0.1 0.11
exposure 1.4
// Wide shot with the glass lantern in frame and 2.5 tower widths of ground on
// either side, then a slow pan right with the fall and a push in on the pile.
at 0: 480 280 zoom=1.1
at 380: 480 280 zoom=1.1
at 560: 524 300 zoom=1.1
at 850: 576 330 zoom=1.25
at 1500: 640 360 zoom=1.5

[expect]
// The pile is still burning and smouldering at the end.
after 1500: count burning_wood in 0 0 960 500 >= 30
after 1500: count charcoal in 0 0 960 500 >= 100
after 1500: count smoke in 0 0 960 500 >= 1000
