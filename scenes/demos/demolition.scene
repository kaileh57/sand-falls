// Demolition at night: a 16 x 36 m brick tower (10 cells per metre) with
// 1.2 m brick walls, brick floor slabs on timber joists, timber columns,
// wooden furniture and glass windows, brought down in real time under real
// gravity.
//
// The charges are explode events; no explosive is packed in the build. Over
// about two seconds they blow out the right wall and the right half of the
// floors on storeys 1-3, then the left timber column on storey 1, then, half a
// second later, the left wall. With nothing under its right half the tower
// comes free as one rigid body (tick 215), drops onto the stump of its left
// wall and pivots right into the gap, taking about four and a half seconds to
// fall. It lands flat on the pad at tick 479; the impact shatters it into
// brick chunks, and a ripple of charges on its slabs and walls, fired over
// the next quarter second, breaks the chunks into rubble, throws sparks and
// lights the timber. The landing raises a dust cloud that billows up off the
// pad (the engine's impact and crack dust plus scripted puffs, see the events)
// and drifts away over about ten seconds, lit by the fire. The scene ends on a
// low, burning, smoking heap of brick and charred timber.
//
// The night sky is deliberate: under dusk or day the sky dome lights dust and
// smoke nearly the colour of the sky, so the cloud does not read.
[scene]
name = demolition
description = Staggered charges cut a brick tower's base at night; it pivots on its last wall, falls for four and a half seconds, shatters on impact in a cloud of dust and burns.
size = 960 540
seed = 0xde30
ticks = 1500

[build]
fill 0 500 960 540 bedrock
terrain 0 960 470 6 120 soil 500
fill 300 440 880 500 concrete
// A soil bank on the right stops sliding wreckage before it leaves the world.
circle 1090 620 280 soil

// Storeys 1-8, 40 cells each: brick walls 12 thick, a brick slab 6 thick on
// 4-cell timber joists, two 10-cell timber columns, glass in the outer walls,
// and wooden furniture on storeys 2-8. A hollow brick plant room and a glass
// lantern on the roof.
fill 400 400 412 440 brick
fill 548 400 560 440 brick
fill 400 400 560 406 brick
fill 412 406 548 410 wood
fill 449 410 459 440 wood
fill 501 410 511 440 wood
fill 400 416 412 427 glass
fill 548 416 560 427 glass
