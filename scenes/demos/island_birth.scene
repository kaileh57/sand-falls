[camera]
// Close on the lake and the curtains hitting the sea for 3 s, then ease out
// to the cliff, the strait and the new island with the steam plume.
view 640 360
scale 3
sky dusk
exposure 1.3
at 0: 275 190 zoom=1.8
at 180: 275 190 zoom=1.8
at 700: 290 188 zoom=1.35
at 1680: 290 188 zoom=1.35

[expect]
// The three curtains fall from the cornice to the sea from the first seconds.
after 150: count lava in 268 143 346 240 > 300
after 150: drawn lava in 268 143 346 240 > 1200
after 600: drawn lava in 268 143 346 220 > 1500
after 1000: drawn lava in 268 143 346 210 > 1200
// Steam boils off the sea entry.
after 300: count steam in 186 -200 640 250 > 400
after 1000: count steam in 186 -200 640 250 > 1200
// New rock: a cone of rubble and gravel grows up from the seabed...
after 600: count rubble in 200 245 420 320 > 600
after 1000: count gravel in 200 245 420 320 > 1500
// ...and breaks the surface as an island.
after 900: count lava in 236 200 380 244 > 1000
// The vents have crusted shut and the lake and island have frozen to basalt.
after 1670: count lava in 186 100 400 300 < 30
after 1670: count basalt in 200 104 346 143 > 1500
after 1670: count rubble in 236 200 380 244 > 200
after 1670: count basalt in 236 200 380 244 > 150
after 1670: count rubble in 236 244 380 262 > 1000
