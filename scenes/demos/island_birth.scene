// The river crusts over and stops feeding the falls.
at 2110: fill 292 245 380 246 basalt
// The surf boils where the falls and the hot new rock meet the sea: steam
// pours off the waterline around the cones, rises through the hot air over
// the falls, and drifts downwind as it cools.
every 2 from 240 to 2110: scatter 522 452 534 468 steam 20
every 2 from 240 to 2110: temp 522 452 534 468 450
// The source thins: the jet retreats toward the rim.
at 1860: fill 498 230 520 300 air
at 1960: fill 486 230 498 300 air
at 2040: fill 442 230 486 300 air
at 2100: fill 380 230 442 300 air
// Drizzle from the steam cloud.
every 3 from 700 to 2280: scatter 522 60 660 62 water 1
every 2 from 2110 to 2280: scatter 380 330 540 332 water 3

[camera]
view 960 540
scale 2
sky night
ambient 0.03 0.03 0.04
exposure 1.5
at 0: 540 395 zoom=1.3
at 240: 540 395 zoom=1.3
at 1200: 560 390 zoom=1.0
at 2040: 580 388 zoom=0.95
at 2280: 600 385 zoom=0.85

[expect]
// The falls are pouring by 5 s: lava in the air over the shelf.
after 300: count lava in 400 252 520 440 > 400
// Cinders break the surface by 15 s and the cones keep growing.
after 900: count rubble in 380 380 560 470 > 800
after 1800: count rubble in 380 300 560 470 > 4000
after 1800: count rubble in 380 300 560 400 > 600
// Steam is rising off the impact zone, and sea mist lies over the water.
after 900: count steam in 380 0 1280 470 > 500
after 900: count mist in 380 0 1280 470 > 500
// The falls have stopped by the end and the new land has cooled.
after 2270: count lava in 400 252 560 440 < 200
after 2270: temp rubble in 380 380 560 470 < 450
