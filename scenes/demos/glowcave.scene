// Glowcave: magma breach.
//
// A dark cavern lit only by blue glowshroom clusters, violet crystal spikes
// and lava. At first it is calm: mist drifts off the shore of a black lake and
// water drips from the stalactites. At tick 300 the obsidian plug holding back
// a magma chamber is blown out with a flash, and glowing droplets of lava arc
// through the dark as particles. The lava pours down a stepped ramp. It holds
// a lot of heat and gives off latent heat before it freezes, so it stays
// molten all the way down while its cooling edges dim from yellow to red, and
// the rock under it heats by conduction. Where it meets the lake the water
// flashes to steam and the lava crusts over as obsidian. At tick 900 the
// feeder runs dry and the flow thins. At tick 1100 a blast cuts the
// neck of a ceiling slab studded with crystals: it falls as a rigid body,
// its crystals still lighting the cave around it, and crashes into the lake.
[scene]
name = glowcave
description = Magma breaches into a dark cavern lit by glowing fungus and crystals: lava pours down a stepped ramp and boils the lake into orange-lit steam, then a crystal-studded slab breaks from the ceiling and crashes into the water.
size = 960 576
seed = 0x91c4
ticks = 1800

[build]
fill 0 0 960 576 stone
// The cavern: a ragged ceiling, with a bulge of rock and domes cut up into
// the rock to break up its outline.
terrain 264 944 128 18 29 air 420
// Bulges of rock hanging from the ceiling, each centred inside the rock.
circle 290 102 26 stone
// Domes cut up into the rock.
circle 352 118 24 air
circle 486 112 30 air
circle 742 110 26 air
circle 868 114 32 air
circle 921 200 25 air
// Magma chamber in the rock at the upper left, behind an obsidian plug.
circle 130 255 60 air
fill 72 255 190 322 air
fill 190 262 252 318 air
fill 72 268 252 318 lava
fill 252 262 264 318 obsidian
// Fresh lava trickles in from the chamber roof and keeps the pool molten.
fill 114 196 146 198 lava_source
// Stepped ramp from the plug down to the lake: four treads tilted toward
// the lake, each about 24 cells below the last, so the lava never falls far.
fill 264 318 266 576 stone
