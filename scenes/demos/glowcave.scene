[events]
// The breach: a blast cracks the cliff face, the plug gives way and the
// lava pours out after it.
at 89: explode 416 424 18 220
at 90: fill 384 410 400 444 air
at 90: explode 388 428 6 60
at 90: explode 420 426 14 120
// The air over the lava entry is kept hot by the lava, so the steam stays
// steam as it rises.
every 2 from 100 to 1800: heat 470 395 45 1
every 4 from 100 to 1800: heat 470 290 55 1
every 4 from 100 to 1800: heat 430 225 28 1
// A spring bursts from the back wall.
at 480: explode 70 282 10 120
at 481: fill 60 272 86 296 air
at 481: fill 62 272 86 273 water_source
// Steam that reaches the attic over the frame vents away.
every 6 from 100 to 1800: fill 320 8 560 46 air
every 6 from 100 to 1800: fill 680 8 910 46 air
// Every few ticks the air just over the open lake is cleared, away from
// the lava. This levels drops that land on the lake, which the engine
// would otherwise stack into thin standing spikes, and acts as the lake's
// overflow.
every 3 from 200 to 1416: fill 520 438 680 454 air
every 3 from 1560 to 1800: fill 520 438 585 454 air
every 3 from 1560 to 1800: fill 632 438 680 454 air
every 3 from 200 to 1800: fill 742 438 762 454 air
every 3 from 200 to 1800: fill 798 438 930 454 air
// The plug gives way further and a second surge of lava follows.
at 1180: fill 384 384 400 444 air
at 1180: explode 386 400 8 80
at 1180: explode 418 406 16 160
// The roof over the right of the lake cracks and a magma dyke pours
// through it in a curtain of lava that falls into the lake.
at 940: explode 779 191 12 220
at 941: fill 770 173 788 193 air
at 941: fill 770 173 788 176 lava_source
at 941: fill 770 176 788 193 lava
at 941: temp 770 173 788 193 1250
every 2 from 960 to 1800: heat 790 395 44 1
every 4 from 960 to 1800: heat 792 295 52 1
// The great stalactite breaks from the roof and falls into the lake.
at 1420: explode 606 193 14 255
at 1420: fill 590 187 622 197 air

