[events]
// The breach: the plug is blown out with a flash, and the blasts in the lava
// behind it throw glowing droplets out into the cave.
at 300: explode 254 300 9 150
at 300: fill 252 262 264 318 air
at 300: explode 245 292 12 255
at 300: explode 245 308 12 255
// The feeder runs dry and the flow from the chamber thins.
at 900: fill 114 196 146 198 stone
// The slab's neck is blasted through and it falls into the lake.
at 1100: explode 655 160 9 220
at 1100: dig 655 160 8

