// Glowcave: magma breach.
//
// A dark cavern lit by violet crystals and blue glowshrooms, over a black
// lake. At tick 90 the obsidian skin between a magma chamber and the lake
// gives way: the lava pours out under the chamber's own weight, runs over a
// rock apron and breaks into the lake. Where it meets the water it boils
// the lake in a column of steam lit orange from below, and its crust breaks
// up into gravel that sinks to the bottom while the lava keeps coming. At
// tick 480 a spring bursts from the back wall, runs over the clifftop and
// falls onto the flow, crusting it and feeding the steam. At tick 940 the
// roof over the far side of the lake cracks and a magma dyke pours through
// it in a glowing curtain that boils its own plume off the lake and lights
// the crystals around it. At tick 1180 the rest of the plug gives way and a
// second surge floods out, and at tick 1420 the great crystal stalactite
// breaks from the roof and plunges into the lake, its crystals still
// glowing under the water.
//
// The rows above the frame hold two hidden attics: the steam rises up two
// chimneys in the roof and is vented there, so it leaves the cave instead
// of raining back down. The air over the lava is kept hot, as the lava
// would keep it, so the steam stays steam while it rises.
// Built by a generator script; 60 ticks a second, so 1800 ticks is 30 s.
[scene]
name = glowcave
description = Magma breaks into a dark cavern lit by glowing crystals and fungus: lava bursts from a chamber and pours into a black lake in a column of orange-lit steam, a spring falls onto the flow from the clifftop, a magma dyke breaks through the roof in a glowing curtain, and the great crystal stalactite plunges into the lake.
size = 960 600
seed = 0x91c4
ticks = 1800
wind = 0

[build]
