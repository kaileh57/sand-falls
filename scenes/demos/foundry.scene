// Foundry: heat capacity and latent heat.
//
// A firebrick pouring box hangs over a quench tank. Its four wells hold
// 2050 C metal over preheated linings and funnel floors. The nozzles are
// tapped one after another (t15-t45), and four white-hot streams fill four
// stepped firebrick molds. The wells drain dry by t280 and are stoppered
// again. Molten metal holds a lot of heat and gives off 300 C of latent heat
// before it freezes, so every mold is full and still liquid when the pour
// ends, and the castings glow on their 1300 C freezing plateau.
//
// At t300 the sluice gate of the cistern on the right lifts. The cistern
// collapses into a wave that pours off the tower onto the highest casting,
// sweeps down the steps over the others, and fills the tank around them.
// Water takes 540 C of latent heat to boil, so every casting it touches
// flashes it to steam. The rising pool swallows the castings one by one and
// freezes them from the top down: they glow orange under the water, then go
// grey (all solid by about t1000). They end grey under standing water.
//
// Steam rises to a vent in the roof, which carries it away (scripted: `fill`
// events clear the vent every 6 ticks). The air under the roof and the
// underside of the box are held at 105 C (scripted `temp` events) so that
// the steam stays steam instead of condensing on them and raining back down
// as streaks; the steam trapped under the box stays as a white bank.
[scene]
name = foundry
description = A pouring box taps four streams of white-hot metal into four stepped firebrick molds, which all fill while still liquid. A cistern's sluice gate then lifts: the water crashes down the steps and fills the tank, flashing to steam on the glowing castings, which freeze under it from orange to grey.
size = 480 320
seed = 0xf0d9
ticks = 1400

[build]
fill 0 0 480 320 stone
fill 16 16 464 300 air
fill 0 300 480 320 bedrock
// A vent in the roof over the whole hall carries the steam away.
fill 20 4 456 16 air
// Pouring box: a firebrick block with four wells, one over each mold, hung
// from the roof on steel rods. The brick around each well is preheated to
// 1350 C, above the metal's freezing point, so no metal freezes on the
// walls, and the funnel floors drain every well dry.
fill 38 4 40 56 metal
fill 83 4 85 56 metal
fill 137 4 139 56 metal
fill 191 4 193 56 metal
fill 236 4 238 56 metal
fill 36 56 240 104 brick
temp 43 56 71 104 1350
temp 97 56 125 104 1350
temp 151 56 179 104 1350
temp 205 56 233 104 1350
fill 46 56 68 100 air
fill 46 68 68 100 molten_metal
temp 46 68 68 100 2050
fill 100 56 122 100 air
fill 100 68 122 100 molten_metal
temp 100 68 122 100 2050
fill 154 56 176 100 air
fill 154 68 176 100 molten_metal
temp 154 68 176 100 2050
fill 208 56 230 100 air
fill 208 68 230 100 molten_metal
temp 208 68 230 100 2050
fill 46 93 47 94 brick
fill 67 93 68 94 brick
fill 46 94 48 95 brick
fill 66 94 68 95 brick
fill 46 95 49 96 brick
fill 65 95 68 96 brick
fill 46 96 50 97 brick
fill 64 96 68 97 brick
fill 46 97 51 98 brick
fill 63 97 68 98 brick
