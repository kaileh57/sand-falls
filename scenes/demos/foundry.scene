[events]
// Pull the nozzle plugs one after another: four streams, one per mold.
at 15: fill 53 100 61 104 air
at 25: fill 107 100 115 104 air
at 35: fill 161 100 169 104 air
at 45: fill 215 100 223 104 air
// The wells are empty: stopper the nozzles again.
at 290: fill 53 100 61 104 brick
at 290: fill 107 100 115 104 brick
at 290: fill 161 100 169 104 brick
at 290: fill 215 100 223 104 brick
// The quench: lift the sluice gate.
at 300: fill 248 40 252 126 air
// The roof vent draws off the steam that reaches it (between the rods).
every 6 from 300 to 1400: fill 20 4 38 14 air
every 6 from 300 to 1400: fill 40 4 83 14 air
every 6 from 300 to 1400: fill 85 4 137 14 air
every 6 from 300 to 1400: fill 139 4 191 14 air
every 6 from 300 to 1400: fill 193 4 236 14 air
every 6 from 300 to 1400: fill 238 4 456 14 air
// Hot air under the roof and along the underside of the box keeps the steam
// from condensing on them and raining back down. The part of the underside
// next to the tower starts once the wave has passed under it.
every 15 from 300 to 1400: temp 16 4 464 56 105
every 15 from 300 to 1400: temp 16 56 36 112 105
every 15 from 300 to 1400: temp 36 96 190 112 105
every 15 from 560 to 1400: temp 190 96 248 112 105
every 15 from 560 to 1400: temp 240 56 248 96 105

[camera]
view 960 540
scale 2
sky cave
ambient 0.7 0.62 0.58
exposure 0.85
// Open close on the pouring box and the four streams, pull back to the
// whole hall for the wave, then move in on the castings in the tank.
at 0: 170 105 zoom=2.9
at 15: 170 105 zoom=2.9
at 200: 190 122 zoom=2.5
at 285: 242 135 zoom=2.2
at 420: 242 135 zoom=2.2
at 750: 200 122 zoom=2.4
at 1400: 180 118 zoom=2.7

[expect]
// No stone melts anywhere.
after 300: count lava in 0 0 480 320 == 0
after 1400: count lava in 0 0 480 320 == 0
// Just before the flood the pouring box is empty, with no metal frozen in
// it, and every mold cavity (600 cells) is full and at least 90% liquid.
after 290: count molten_metal in 36 56 240 104 == 0
after 290: count metal in 36 56 240 104 == 0
after 290: count air in 32 168 82 180 == 0
after 290: count air in 86 162 136 174 == 0
after 290: count air in 140 156 190 168 == 0
after 290: count air in 194 150 244 162 == 0
after 290: count molten_metal in 32 168 82 180 >= 540
after 290: count molten_metal in 86 162 136 174 >= 540
after 290: count molten_metal in 140 156 190 168 >= 540
after 290: count molten_metal in 194 150 244 162 >= 540
// The water boils to steam on the castings.
after 600: count steam in 0 0 480 320 > 1000
// Every casting is solid by t1100 and whole at the end, no metal is left
// anywhere above the molds, and standing water covers all four castings.
after 1100: count molten_metal in 0 0 480 320 == 0
after 1400: count metal in 32 168 82 180 >= 590
after 1400: count metal in 86 162 136 174 >= 590
after 1400: count metal in 140 156 190 168 >= 590
after 1400: count metal in 194 150 244 162 >= 590
after 1400: count metal in 16 57 464 146 == 0
after 1400: count water in 32 140 244 148 >= 1500
