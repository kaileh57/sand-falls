// Foundry: heat capacity and latent heat.
//
// A brick crucible taps molten metal down a cascade of four firebrick molds.
// Each mold fills, overflows its lip into the next one, and the last spills
// into a water quench tank. The metal holds its 1300 C freezing plateau long
// enough to fill every mold, glowing orange while it crystallises in from the
// walls. In the tank the water warms and boils steadily rather than flashing,
// and the metal sinks to the floor. Sprinklers then quench the castings, which
// cool from white-yellow through orange and red to grey.
[scene]
name = foundry
description = Molten metal fills a cascade of four molds on its freezing plateau, overflows into a quench tank that boils steadily, then sprinklers cool the castings from white-yellow to grey.
size = 768 432
seed = 0xf0d9
ticks = 2700

[build]
fill 0 0 768 432 stone
// The hall. Bedrock under the floor anchors everything built on it.
fill 20 40 748 380 air
fill 0 400 768 432 bedrock
// Crucible: a brick shell over heaters, full of molten metal, tapped through
// a hole low in its right wall.
fill 40 60 160 172 brick
fill 50 70 150 160 air
fill 50 160 150 166 heater
fill 50 112 150 160 molten_metal
fill 150 150 160 160 air
fill 40 172 160 380 stone
// Four firebrick molds, each floor 20 cells below the last. The wall between
// two molds is topped at the lower mold's lip, so a full mold spills over it.
fill 154 172 158 200 brick
fill 154 200 202 206 brick
fill 158 186 198 200 air
fill 198 186 202 226 brick
fill 198 220 246 226 brick
fill 246 206 250 246 brick
fill 246 240 290 246 brick
fill 290 226 294 266 brick
fill 290 260 334 266 brick
fill 334 246 338 306 brick
fill 154 206 198 380 stone
fill 202 226 246 380 stone
fill 250 246 290 380 stone
fill 294 266 334 380 stone
// The quench tank, brick on stone, full of water.
fill 338 300 470 306 brick
fill 466 230 470 306 brick
fill 338 262 466 300 water
fill 338 306 470 380 stone
// A torch on the far wall for a little warm fill light.
fill 20 120 22 124 torch

[events]
// The quench: sprinklers over each casting, then shut off.
at 1000: fill 166 150 168 151 water_source
at 1000: fill 210 166 212 167 water_source
at 1000: fill 256 186 258 187 water_source
at 1000: fill 300 206 302 207 water_source
at 1500: fill 166 150 168 151 air
at 1500: fill 210 166 212 167 air
at 1500: fill 256 186 258 187 air
at 1500: fill 300 206 302 207 air

[camera]
view 768 432
scale 2
sky cave
ambient 0.03 0.026 0.024
exposure 1.3
at 0: 200 170 zoom=2
at 300: 210 180 zoom=2
at 900: 300 220 zoom=1.6
at 1000: 310 225 zoom=1.6
at 1800: 310 225 zoom=1.6
at 2700: 260 215 zoom=1.8

[expect]
after 300: count lava in 20 40 748 400 == 0
after 900: count lava in 20 40 748 400 == 0
after 1800: count lava in 20 40 748 400 == 0
after 2400: count molten_metal in 158 186 334 260 == 0
after 2700: count lava in 20 40 748 400 == 0
