// Foundry: heat capacity and latent heat.
//
// A brick crucible over a heater taps white-hot metal through a small hole
// down a cascade of four firebrick molds. Each mold fills, spills over its
// lip into the next, and the last one overflows into the dry end of a quench
// tank, where the metal pools on the floor. Molten metal holds a lot of heat
// and gives off 300 C of latent heat as it freezes, so the pour stays liquid
// all the way down and every mold fills before it sets. The castings cool to
// their 1300 C freezing plateau and sit there, glowing yellow, while they
// crystallise in from the mold walls.
//
// At tick 1000 the quench starts. A sprinkler bar rains on each casting, and
// the tank's sluice gate opens so its water floods over the pool of metal.
// Water takes 540 C of latent heat to boil, so it boils where it touches hot
// metal, steadily rather than all at once, and steam rises off the castings.
// The water freezes the castings from the top down: a crust cools through
// orange and red to grey while the core below stays on its freezing plateau,
// and by the end all four castings, and the slab on the tank floor, are grey.
[scene]
name = foundry
description = A crucible pours molten metal down four cascading molds, which all fill while still liquid, and the overflow pools on the floor of a quench tank. Sprinklers and a flooding sluice then quench the metal: the water boils steadily into steam, and the castings cool from the top down through orange and red to grey.
size = 768 432
seed = 0xf0d9
ticks = 2700

[build]
fill 0 0 768 432 stone
// The hall. Bedrock under the floor anchors everything built on it.
fill 20 40 748 380 air
fill 0 400 768 432 bedrock
// Crucible: a brick shell over a heater, full of molten metal, tapped through
// a hole low in its right wall.
fill 40 60 160 172 brick
fill 50 70 150 160 air
fill 50 160 150 166 heater
fill 50 128 150 160 molten_metal
temp 50 128 150 160 2050
fill 150 156 160 160 air
fill 40 172 154 380 stone
fill 154 172 160 186 brick
// Four firebrick molds, each 40 x 14 and 20 cells below the last. The wall
// between two molds is topped at the higher mold's lip, so a full mold spills
// over it into the next.
fill 154 172 158 200 brick
fill 154 200 202 206 brick
fill 158 186 198 200 air
fill 198 186 202 226 brick
fill 198 220 246 226 brick
fill 246 206 250 246 brick
fill 246 240 290 246 brick
fill 290 226 294 266 brick
fill 290 260 334 266 brick
fill 334 246 338 308 brick
fill 154 206 198 380 stone
fill 202 226 246 380 stone
fill 250 246 290 380 stone
fill 294 266 334 380 stone
// The quench tank. The last mold overflows into its dry left end; a brick
// sluice gate holds the water in the right end until the quench. The right
// wall is lower than the last mold's lip, so runoff spills out to the right
// instead of backing up over the castings.
fill 338 300 470 308 brick
fill 466 256 470 308 brick
fill 338 308 470 380 stone
fill 402 262 466 300 water
fill 398 258 402 300 brick
// A torch on the far wall for a little warm fill light.
fill 20 120 22 124 torch

[events]
// The crucible is empty: shut the heater off.
at 800: fill 50 160 150 166 brick
// The quench: open the sluice gate and turn on a sprinkler bar over each
// casting, then shut the sprinklers off.
at 1000: fill 398 258 402 300 air
at 1000: fill 156 170 188 171 water_source
at 1000: fill 200 186 232 187 water_source
at 1000: fill 246 206 278 207 water_source
at 1000: fill 290 226 322 227 water_source
at 1150: fill 156 170 188 171 air
at 1150: fill 200 186 232 187 air
at 1150: fill 246 206 278 207 air
at 1150: fill 290 226 322 227 air

[camera]
view 960 540
scale 2
sky cave
ambient 0.55 0.5 0.48
exposure 0.32
// Open on the tap and the stream, pan down the cascade as the molds fill,
// hold on the molds and tank for the quench, and end on the dulling castings.
at 0: 200 170 zoom=2
at 300: 210 180 zoom=2
at 900: 305 215 zoom=2.2
at 1800: 305 215 zoom=2.2
at 2700: 305 226 zoom=2.8

[expect]
// No stone melts into lava anywhere in the hall.
after 300: count lava in 20 40 748 400 == 0
after 900: count lava in 20 40 748 400 == 0
after 1800: count lava in 20 40 748 400 == 0
after 2700: count lava in 20 40 748 400 == 0
// When the quench starts every mold is at least 95% full (cavities of 560,
// 616, 560 and 560 cells; no water has reached them yet, so whatever is not
// air is metal) and at least 90% of each is still liquid.
after 1000: count air in 158 186 198 200 <= 28
after 1000: count air in 202 206 246 220 <= 30
after 1000: count air in 250 226 290 240 <= 28
after 1000: count air in 294 246 334 260 <= 28
after 1000: count molten_metal in 158 186 198 200 >= 504
after 1000: count molten_metal in 202 206 246 220 >= 555
after 1000: count molten_metal in 250 226 290 240 >= 504
after 1000: count molten_metal in 294 246 334 260 >= 504
// The overflow pools on the tank floor, still liquid, before the flood.
after 1000: count molten_metal in 338 262 466 300 >= 300
// Steam rises in the quench.
after 1100: count steam in 20 40 748 380 > 800
// The tank boils off only gradually: at least 85% of its starting 2432 cells.
after 1500: count water in 338 262 466 300 >= 2068
// The tank metal froze in place on the floor, and the castings are solid.
after 1800: count metal in 338 262 466 300 >= 300
after 2400: count molten_metal in 158 186 334 260 == 0
