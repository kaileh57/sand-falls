// The stress test: a reservoir of 4 million water cells (204 x 195 m at 10
// cells per metre) released into a valley, in an 8.4-million-cell world.
//
// Charges go off at the foot of the dam at tick 1 and the whole dam is removed,
// so no water is deleted. The flood spills into a bowl below the dam where a
// village stands: wooden houses and trees are bodies hinged to the brick
// houses, which are pinned to the ground. As the water rises the wooden houses
// and trees float, break their hinges and drift; the brick houses stay put.
// Further on the flood runs over a small lava pool kept hot by lava sources.
// The camera opens on the whole reservoir and follows the wave front into the
// village.
[scene]
name = dam break
description = Charges blow out a concrete dam holding 4 million water cells; the flood pours into a valley village, lifts its wooden houses and trees off their footings and swamps a lava pool.
size = 4096 2048
seed = 22
ticks = 1500

[build]
// Valley: a stone plateau with a bowl carved below the dam. Two offset circles
// leave a soil skin on the bowl floor; the arcs they leave in the sky on the
// right are cleared again.
fill 2056 1400 4088 2000 stone
circle 2300 650 1300 soil
circle 2300 620 1300 air
fill 3300 0 4088 1400 air
fill 0 2000 4096 2048 bedrock
fill 0 0 8 2000 bedrock
fill 4088 0 4096 2000 bedrock
// The dam and its 4-million-cell reservoir.
fill 2048 20 2056 2000 concrete
fill 8 46 2048 2000 water
// tree, body 0
fill 2111 1907 2140 1912 soil
fill 2123 1871 2127 1907 wood
circle 2125 1871 14 leaves
carve 2111 1857 2140 1907
// wooden house, body 1
fill 2159 1913 2191 1918 stone
fill 2160 1897 2190 1913 wood
fill 2164 1900 2170 1905 glass
fill 2180 1900 2186 1905 glass
fill 2171 1889 2179 1891 wood
