[expect]
// All the water is there at the start.
after 1: count water in 0 0 2048 1152 == 149040
// The gate holds until it goes: nothing has got past it.
after 38: count water in 769 0 2040 1132 == 0
// A second after the gate goes, the face has slumped out over the apron.
after 100: count water in 769 0 1012 750 > 10000
// Within 4.5 s of the gate going the front has crossed the valley to the foot
// of the far hillside, 950 cells (95 m) away.
after 300: count water in 1700 0 2040 850 > 2000
// The surge runs up the hillside more than 10 m above the valley floor, and
// more than 20 m.
after 450: count water in 1800 0 2040 750 > 20000
after 500: count water in 1850 0 2040 650 > 10000
// The reservoir has emptied into the valley, and no water was made or lost.
after 1200: count water in 330 0 744 650 == 0
after 1200: count water in 330 0 744 750 < 40000
after 1200: count water in 0 0 2048 1152 == 149040
