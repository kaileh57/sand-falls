// Pull back to the whole streamed band.
at 1500: -30 430 zoom=0.6
at 1650: -30 430 zoom=0.6

[expect]
// He reaches bedrock and stays on the tunnel floor.
after 1320: avatar 0 x > 430
after 1320: avatar 0 y > 710
after 1650: avatar 0 y > 710
// Streaming: the lamps at the tunnel mouth are loaded while he is near them
// and stored (gone from the live world) by the end.
after 400: count torch in -830 100 -560 260 > 40
after 1650: count torch in -830 100 -560 260 == 0
// The north-east corner of the frame is never generated.
after 1650: count stone in 640 0 960 200 == 0
// Lava pockets stream in molten as he nears the deep caves.
after 780: count lava in -100 380 260 640 > 300
// The lamps along the part of the tunnel still loaded at the end.
after 1650: count torch in -460 300 460 740 > 120
