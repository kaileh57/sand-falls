// Deep Descent: procedural world generation and chunk streaming.
//
// No terrain in this file is hand-built, and nothing is heated, placed or
// carved except by the miner's own tools. Every cell comes from the `caves`
// world generator and the seed: rolling hills under a soil crust, stone with
// coal, moss-lit caves near the surface, caves lit blue by glowshroom and
// violet by crystal further down, water pockets in the shallow caves, lava
// pockets in the deep ones, and dark bedrock 600 cells below the surface.
//
// Chunk streaming is on screen. Only chunks within 5 of the miner are kept
// live; the rest of the world does not exist yet (black). As he bores east,
// a new column of 64x64 chunks is generated at the right edge of the frame
// about once a second, and the lava pockets in them arrive molten and crust
// over to basalt as he passes. Chunks more than 13 away are stored. The final
// pull-back shows the world as the engine holds it: a lit band of generated
// chunks stepping down along his tunnel, never-generated chunks to the north
// east, and the tunnel's first 350 cells, lamps and all, already stored.
//
// The miner (player 0) is driven by timeline input. He walks at full speed
// (one cell a tick, 6 m/s) while the dig tool clears a disc ahead of and
// below him, and the paint tool hangs a lamp (torch) on the tunnel roof
// about every 44 cells, so the bore is traced by a line of lights. He breaks
// through into a big cave at about 11 s and drops 90 cells to its floor,
// crosses the lava caves and stops on bedrock at about 22 s.
[scene]
name = deep descent
description = A miner bores a lamp-lit tunnel 580 cells down through a procedurally generated world that is streamed in chunk by chunk around him: soil and coal, caves lit by moss, glowshroom and crystal, molten lava pockets that crust over as he passes, down to bedrock, then the camera pulls back to show the band of generated chunks he left behind.
// The renderer keeps the camera inside the scene bounds, and the bounds are
// loaded when the scene starts. Streaming stores every chunk of them more
// than 13 chunks from the miner on the first tick, so what the camera shows
// east of x 64 is streamed back in only when he comes within 5 chunks of it.
bounds = -1216 -128 960 960
seed = 45
worldgen = caves 120
// Keep chunks within 5 of the miner loaded: ahead of him the loaded world
// ends about 330 cells away, inside the tracking frame, so the frontier and
// each new column of chunks are visible at its right edge. Store chunks more
// than 5 + 8 away.
stream = 5 8
ticks = 1650

[build]
player 0 -800 140

[events]
// A lamp beside him at the entrance, once he has landed.
at 50: input 0 tool=paint param=torch aim=-7,4 use
// The bore: full walking speed, digging a 9-cell disc ahead and below. The
// slope (about 20 degrees) comes from the aim.
at 60..1340: input 0 move=1 tool=dig param=9 aim=12,4 use
// Lamps on the tunnel roof, every 44 ticks. Ticks where the roof is out of
// reach are left out so no lamp hangs in the air: 104 (still at the
// surface), 280, 456 and 588 (the bore crosses the top of a small cave,
// 456 moved to 440 and 588 to 604), and 676 to 896, the drop through the
// big cave.
at 148: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 192: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 236: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 324: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 368: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 412: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 440: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 500: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 544: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 604: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 632: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 940: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 984: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1028: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1072: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1116: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1160: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1204: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1248: input 0 move=1 tool=paint param=torch aim=-3,-12 use
at 1292: input 0 move=1 tool=paint param=torch aim=-3,-12 use
// He stops on bedrock. A small dig around his body each tick keeps loose
// rubble out of his box.
at 1341..1650: input 0 move=0 tool=dig param=8 aim=0,-2 use

[camera]
view 960 540
scale 2
// A cave sky: air that reaches the top of the frame underground stays dark
// instead of reading as open sky, and above the hills it reads as night.
sky cave
ambient 0.1 0.1 0.12
exposure 3.8
// One second on the miner and his lamp at the surface.
at 0: -790 140 zoom=1.3
at 60: -790 140 zoom=1.3
// Tracking, 4 ticks apart so the eased segments join into an even glide: the
// miner's measured path, smoothed over a second, with the frame 70 cells
// ahead of him so the streaming frontier sits in its right-hand part.
at 64: -794 144 zoom=1.3
at 68: -791 144 zoom=1.3
at 72: -788 145 zoom=1.3
at 76: -784 146 zoom=1.3
