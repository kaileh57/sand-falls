[expect]
// The surge reaches the foot of the slope by tick 140.
after 140: count water in 296 140 304 150 > 0
// It runs up more than 35 cells but not 110.
after 180: count water in 304 0 768 115 > 0
after 180: count water in 0 0 768 40 == 0
// The thin tip keeps climbing, to about 135 cells by tick 360, then slides
// back; the film it leaves on the slope drains last. By tick 700 it is all
// below 25 cells.
after 700: count water in 304 0 768 125 == 0
// It settles into a lake 15 to 17 deep and sleeps, every cell kept.
after 4000: asleep
after 4000: count water in 0 0 768 133 == 0
after 4000: count water in 100 135 101 136 == 1
after 4000: count water in 0 0 768 192 == 4800
