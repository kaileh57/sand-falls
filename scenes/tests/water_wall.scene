// A tall block of water released toward open floor on its right must
// collapse and level out, not stand as a vertical face that drains a few
// cells per tick. Its front reaches the far end within 100 ticks, then it
// sloshes between the ends; 12,700 cells over a 316-wide floor level at
// about y 100.
[scene]
name = water wall
size = 320 160
seed = 5
ticks = 1000

[build]
fill 0 140 320 160 bedrock
fill 0 0 4 140 bedrock
fill 4 40 131 140 water

[expect]
after 100: count water in 300 0 320 140 > 300
after 1000: count water in 0 0 320 92 < 50
after 1000: count water in 200 104 320 140 > 4000
after 1000: count water in 0 0 320 160 == 12700
