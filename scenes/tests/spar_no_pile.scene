// A long spar and a mast with a cross-tree float in a pool. Water the bodies
// push aside goes into the room they leave behind them or onto the lowest part
// of the surface nearby, and a body is no floor with a hole in it, so no water
// piles up on the spar or against the mast. In the rejected build water was
// stamped up the bodies' outlines and held over them as if in a hole in a
// floor, and stood 20 to 60 rows over the sea on a 3x150 mast plank.
[scene]
name = spar no pile
size = 320 256
seed = 21

[legend]
w wood body
. air

[grid 120 60]
