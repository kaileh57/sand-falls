// A red-hot metal casting dropped into a tank of water cools by conduction and
// boiling. Water has twice the heat capacity of air per cell, and boiling it
// takes 540 C of latent heat, so the tank loses only a little water as steam.
[scene]
name = quench
size = 80 100
seed = 5

[build]
fill 0 0 80 100 stone
fill 4 4 76 96 air
fill 0 92 80 100 bedrock
fill 10 50 70 92 brick
fill 14 50 66 88 water
fill 30 66 50 86 metal
temp 30 66 50 86 1250

[expect]
after 30: count water in 10 40 70 92 >= 1350
after 40: temp metal in 30 66 50 86 < 900
after 120: count water in 10 40 70 92 >= 1350
after 140: temp metal in 30 66 50 86 < 500
