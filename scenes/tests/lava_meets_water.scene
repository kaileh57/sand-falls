// Lava poured into water hardens into obsidian and boils water into steam.
[scene]
name = lava meets water
size = 128 128
seed = 4

[build]
fill 0 120 128 128 bedrock
fill 0 60 4 120 bedrock
fill 124 60 128 120 bedrock
fill 4 95 124 120 water
fill 50 20 78 40 lava

[expect]
// Water and lava react into steam and obsidian. Obsidian that forms over water
// is not resting on anything, so it crumbles to gravel and sinks, and fresh
// lava keeps reaching the water; lava that freezes while it falls crumbles to
// rubble. Boiling uses up some water as steam, which hangs over the tank.
after 600: count lava in 0 0 128 128 < 100
after 600: count gravel in 0 0 128 128 >= 150
after 600: count rubble in 0 0 128 128 >= 100
after 600: count steam in 0 0 128 128 >= 300
after 600: count water in 0 0 128 128 < 3000
