// A ball of lava that cools while it falls lands as a heap: lava that freezes
// in the air turns to rubble, not to basalt hanging in mid-air.
[scene]
name = lava drop
size = 192 256
seed = 22

[build]
fill 0 240 192 256 bedrock
circle 96 30 10 lava
temp 80 14 112 46 760

[expect]
// The heap is about 12 cells tall; a pocket of lava inside it may freeze to
// basalt there, but none freezes above it. Thick lava lands as a compact
// heap, whose last liquid cells freeze by tick 900.
after 900: count basalt in 0 0 192 224 == 0
after 900: count lava in 0 0 192 236 == 0
