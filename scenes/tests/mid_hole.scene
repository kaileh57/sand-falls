// A tank drains through a 4-cell hole halfway up its wall. The water leaves
// as one jet at the Torricelli speed for its head, sqrt(2 g h), about 1.6
// cells per tick at first, so it clears the 40-cell ledge below and lands
// well out in the pit. The tank drains to the floor of the hole, every cell
// kept, and sleeps.
[scene]
name = mid hole
size = 640 260
seed = 11
ticks = 4500

[build]
fill 0 200 640 260 bedrock
fill 0 40 4 200 bedrock
fill 636 40 640 260 bedrock
fill 168 200 636 250 air
fill 124 60 128 200 bedrock
fill 124 150 128 154 air
fill 4 100 124 200 water

[expect]
// Ballistics land the jet about 115 cells out; poured at 60% of that speed
// it landed about 50 out, at the foot of the ledge.
after 150: count water in 200 200 640 250 > 250
after 150: count water in 168 200 200 250 < 40
after 4500: count water in 4 0 124 154 == 0
after 4500: count water in 4 154 124 200 == 5520
after 4500: count water in 0 0 640 260 == 12000
after 4500: asleep
