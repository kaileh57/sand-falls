// Flood rescue, co-op. A reservoir held back by a stone dam sits above a
// cave system. Four players stand on a bedrock lip in the tunnel under the
// dam, behind an iron-hard railing, and dig out the soil plug in the tunnel
// floor in front of them. Their cut frees the rest of the plug, which drops
// into the empty cavern below as one block. The dam springs a leak, a jet
// arcing across the hall onto the plug, then bursts: the flood surges along
// the tunnel and pours down the players' slot into the cavern as a curtain,
// while the crew runs for the dry landing past the berm. A spring keeps the
// reservoir running. Once the cavern is deep the crew drops down the shaft to
// a ledge in the lava well and cuts the beam that holds the drain gate in the
// cavern floor: the gate falls into the lava and the cavern pours down onto
// it, which boils and crusts over. The villagers sit dry in a lit bedrock
// vault under the reservoir.
[scene]
name = flood rescue
description = Co-op: four players dig a slot through the tunnel floor to steer a real-time flood from a burst dam into a cavern, then cut the beam that holds its drain gate so the cavern pours onto a lava well, while the villagers stay dry.
size = 640 480
seed = 0xf100d
spawn = 480 172
spawn = 486 172
spawn = 474 172
spawn = 604 172
ticks = 2400

[build]
fill 0 0 640 480 stone
fill 0 0 640 4 bedrock
fill 0 470 640 480 bedrock
fill 0 0 6 480 bedrock
fill 634 0 640 480 bedrock

// The reservoir, a hundred rows deep, under a domed roof. A spring pipe in
// its left wall keeps it running once the dam goes.
fill 30 44 236 172 air
circle 125 52 34 air
circle 52 52 16 air
circle 208 52 16 air
fill 30 64 236 172 water
fill 8 58 26 172 air
fill 8 64 26 172 water
fill 26 58 30 150 stone
fill 12 58 20 59 water_source

// A tall hall below the dam, and the tunnel from it, with a ragged roof.
fill 252 112 624 172 air
fill 252 56 316 172 air
circle 284 64 30 air
circle 318 112 20 air
circle 360 110 10 air
circle 450 112 14 air
circle 540 110 12 air
circle 600 114 10 air
// The dam: the stone between the reservoir and the hall, x 236..252.

// Everything the crew can reach from where they stand is bedrock, so their
// tools only bite where the story needs them to: the slot, and the beam.
fill 300 172 634 204 bedrock
fill 560 132 634 356 bedrock
fill 486 288 634 356 bedrock
fill 560 112 624 172 air
circle 600 114 10 air

// The cavern under the tunnel.
fill 230 186 448 300 air
circle 380 214 30 air
circle 300 200 14 air
fill 300 172 448 186 bedrock
fill 230 300 448 314 stone

// The slot: a soil plug through the tunnel floor over the cavern. A seam of
// moss on its left holds nothing up, so the plug hangs from the bedrock lip
// on its right: once the crew cuts through by the lip, the rest drops out.
fill 372 172 430 186 soil
fill 370 172 372 186 moss
// The railing on the lip keeps the crew out of the slot and turns back the
// part of the surge that jumps it.
fill 430 132 434 172 bedrock

