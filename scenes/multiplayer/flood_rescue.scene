// Flood rescue, co-op: an underground lake breaks through the roof of a cave
// system. A slab of the lake floor drops out as a rigid body and the flood
// pours down two fissures into the top tunnel, runs both ways along it and
// spills down the open left and right shafts into the middle caves, which
// fill to pools. The players start in the top tunnel over a sealed, lit
// gallery: their digging breaks its thin rock floor, and new waterfalls pour
// in where there was rock. Below the gallery a soil plug holds the centre
// shaft; once they dig it out, the water they steered fills the centre
// chamber instead of running on down the right-hand way. That way spills
// over a sill onto a lava pocket and crusts it over, until a charge drops
// the lower tunnel into a deep well. A second charge drains the left chamber
// into the sump. The villagers sit dry in a lit bedrock vault at the
// bottom, which no digging can break.
[scene]
name = flood rescue
description = Co-op: an underground lake bursts into a cave system; four players dig through the rock under their feet to open new waterfalls and steer the flood through tunnels, shafts and chambers, while charges blast drains past a lava pocket and around the villagers' lit vault.
size = 640 480
seed = 0xf100d
spawn = 300 120
ticks = 2400

[build]
fill 0 0 640 480 stone
fill 0 470 640 480 bedrock
fill 0 0 6 480 bedrock
fill 634 0 640 480 bedrock

// The underground lake, topped up by springs, and the fissures in its floor.
fill 130 8 470 58 air
circle 250 12 34 air
circle 400 14 30 air
fill 130 16 470 58 water
fill 226 6 266 8 water_source
fill 400 8 430 10 water_source
fill 226 58 262 72 air
circle 244 62 12 air
fill 410 58 434 72 air
circle 422 62 10 air
// A rock column holds up the lake floor between the fissures.
fill 326 8 342 58 stone
circle 334 58 10 stone

// Top tunnel, floor at 130, with a ragged roof.
fill 14 72 620 130 air
circle 60 72 14 air
circle 160 78 12 air
circle 400 72 16 air
circle 480 70 10 air
circle 570 72 14 air
circle 200 132 6 stone
circle 430 132 5 stone

// A gallery right under the players' feet, sealed off by a thin floor of
// rock. Their digging breaks through it, and the flood pours in.
fill 180 142 440 172 air
circle 236 150 10 air
circle 384 150 10 air
circle 300 168 14 air
// Shafts from the top tunnel to the middle caves.
// Left shaft, open: the flood's first way down.
fill 100 130 128 236 air
// Centre shaft from the gallery floor, plugged with soil.
fill 288 172 312 250 air
fill 288 172 312 190 soil
// Right shaft, open.
fill 520 130 548 236 air

// Middle caves: three chambers, each fed by its own shaft.
fill 60 230 210 320 air
circle 120 232 26 air
fill 250 250 400 320 air
circle 330 254 30 air
fill 440 230 590 320 air
circle 520 232 26 air

// Left shaft down to the sump, behind a thin stone wall at its top.
fill 90 324 116 350 air
// The sump: a big empty cave on the lower left, and an old tunnel from it
// that ends at the vault wall.
fill 14 350 220 462 air
circle 110 366 24 air
fill 220 372 252 392 air

// The right chamber drains over a sill in its far wall, so it fills to a
// pool first, then spills down a shaft to the lower tunnel.
fill 590 300 606 310 air
fill 594 302 612 352 air
// Lower tunnel, floor at 392, running left over the vault.
fill 420 352 620 392 air
// A lava pocket right under the spill: water that takes this way boils.
fill 556 392 618 436 air
fill 556 404 618 436 lava
// A deep well under the tunnel, behind a thin stone floor.
fill 440 396 520 464 air

// The villagers' vault: a sealed bedrock shell no digging can break.
fill 254 394 410 456 bedrock
fill 260 400 404 450 air

// Wooden huts on the vault floor.
fill 272 434 274 450 wood
fill 292 434 294 450 wood
fill 270 432 296 434 wood
fill 273 430 293 432 wood
fill 276 428 290 430 wood
fill 279 426 287 428 wood
fill 316 432 318 450 wood
fill 340 432 342 450 wood
fill 314 430 344 432 wood
fill 317 428 341 430 wood
fill 320 426 338 428 wood
fill 323 424 335 426 wood
fill 326 422 332 424 wood
fill 362 436 364 450 wood
fill 380 436 382 450 wood
fill 360 434 384 436 wood
fill 363 432 381 434 wood
fill 366 430 378 432 wood
// Torches inside and between the huts.
fill 282 440 284 443 torch
fill 328 438 330 441 torch
fill 371 442 373 445 torch
fill 262 412 264 415 torch
fill 304 410 306 413 torch
fill 352 410 354 413 torch
fill 396 412 398 415 torch
// Glowshroom garden.
fill 300 446 301 450 glowshroom
fill 298 444 303 446 glowshroom
fill 305 447 306 450 glowshroom
fill 304 445 307 447 glowshroom
fill 349 446 350 450 glowshroom
fill 347 444 352 446 glowshroom
fill 354 447 355 450 glowshroom
fill 353 445 356 447 glowshroom
fill 388 446 389 450 glowshroom
fill 386 444 391 446 glowshroom

// Torches along the tunnels.
fill 130 112 132 115 torch
fill 220 112 222 115 torch
fill 400 112 402 115 torch
fill 590 112 592 115 torch
fill 70 290 72 293 torch
fill 200 296 202 299 torch
fill 460 290 462 293 torch
fill 256 284 258 287 torch
fill 330 270 332 273 torch
fill 392 284 394 287 torch
fill 580 296 582 299 torch
fill 470 372 472 375 torch
fill 30 420 32 423 torch
fill 200 420 202 423 torch
fill 186 156 188 159 torch
fill 300 150 302 153 torch
fill 432 156 434 159 torch
// Glowshroom clusters on the floors and moss on the roofs.
decorate 14 72 620 130 glowshroom 2 floor
decorate 180 142 440 172 glowshroom 4 floor
decorate 60 230 590 320 glowshroom 2 floor
decorate 14 350 220 462 glowshroom 2 floor
// No moss under the lake floor: it would pin the slab that breaks away.
decorate 14 60 150 462 moss 2 ceiling
decorate 280 60 620 462 moss 2 ceiling
decorate 150 140 280 462 moss 2 ceiling

[events]
// The lake floor cracks: the slab beside the left fissure is cut loose,
// falls into the top tunnel as a rigid body, and the lake pours through.
at 90: explode 168 65 7 160
at 90: dig 168 65 8
// A charge blows a hole in the thin floor of the lower tunnel, and the water
// there drains into the well instead of running on toward the vault.
at 960: explode 476 394 7 200
// Another blasts the thin wall at the bottom of the left chamber, and the
// left chamber drains into the sump.
at 1470: explode 103 322 7 200

[camera]
view 640 360
scale 3
sky cave
ambient 0.09 0.095 0.115
exposure 1.6
// The lake breaks into the top tunnel while the players dig through the
// gallery floor under their feet.
at 0: 300 112 1.4
at 520: 300 112 1.4
// Down to the lower tunnel as the right-hand spill reaches the lava, and
// the charge drops the water into the well.
at 620: 462 368 1.8
at 1020: 462 368 1.8
// Back up to the diggers, and the waterfalls their breaches feed.
at 1120: 310 178 1.35
at 1340: 310 178 1.35
// The charge at the bottom of the left chamber drains it into the sump.
at 1420: 250 316 1.35
at 1680: 250 316 1.35
// The whole cave system, then the villagers, safe and dry in their vault.
at 1780: 320 248 0.8
at 2180: 320 248 0.8
at 2320: 332 378 1.8
at 2400: 332 378 1.8
