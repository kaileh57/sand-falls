fill 0 0 640 480 stone
fill 0 0 640 4 bedrock
fill 0 470 640 480 bedrock
fill 0 0 6 480 bedrock
fill 634 0 640 480 bedrock

// The reservoir, a hundred rows deep, under a domed roof. A spring rains
// into a chamber at its left end and keeps it running once the dam goes.
fill 30 44 236 172 air
