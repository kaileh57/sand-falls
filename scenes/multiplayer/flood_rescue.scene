[camera]
view 640 360
scale 3
sky cave
ambient 0.2 0.2 0.24
exposure 1.6
// The reservoir, the dam and the crew waiting by the berm.
at 0: 330 132 1.25
at 80: 340 140 1.3
// The crew cuts the slot and the leak arcs onto it.
at 140: 375 160 1.6
at 280: 375 160 1.6
// The burst and the surge reaching the slot.
at 330: 340 160 1.25
at 560: 350 176 1.25
// The flood pours down the slot into the cavern.
at 660: 345 232 1.35
at 1120: 345 232 1.35
// The crew drops down the shaft to the shelf and walks out over the well.
at 1180: 540 290 1.45
at 1270: 540 290 1.45
at 1390: 420 320 1.45
// They cut the gate's arm, and the cavern pours down onto the lava.
at 1440: 400 350 1.25
at 1820: 400 350 1.25
// The whole cave system, then the villagers, safe and dry in their vault.
at 1900: 320 240 0.75
at 2150: 320 240 0.75
at 2260: 130 396 1.7
at 2400: 130 396 1.7

[expect]
// The reservoir holds until the dam bursts; then the surge fills the tunnel.
after 200: count water in 30 44 236 172 > 18000
after 360: count water in 252 112 430 172 > 1000
// The flood pours down the crew's slot and fills the cavern.
after 600: count water in 230 186 448 300 > 2000
after 1200: count water in 230 186 448 300 > 12000
// The drain pours into the well, where the lava boils it and crusts over.
after 1700: count water in 294 314 520 470 > 1500
after 1700: count steam in 0 0 640 480 > 30
after 1700: count obsidian in 294 400 520 470 > 40
// The villagers' vault stays dry.
after 2400: count water in 22 322 238 470 == 0

