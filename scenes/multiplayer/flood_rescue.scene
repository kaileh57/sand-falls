[expect]
// The reservoir holds until the dam bursts; then the surge fills the tunnel.
after 200: count water in 30 44 236 172 > 18000
after 360: count water in 252 112 430 172 > 1000
// The flood pours down the crew's slot and fills the cavern.
after 600: count water in 230 186 448 300 > 2000
after 1200: count water in 230 186 448 300 > 12000
// The drain pours into the well, where the lava boils it and crusts over.
after 1700: count water in 294 314 520 470 > 1500
after 1700: count steam in 0 0 640 480 > 40
after 1700: count obsidian in 294 400 520 470 > 30
// The villagers' vault stays dry.
after 2400: count water in 22 322 238 470 == 0

