// Chaos soak: bots dig, paint, heat, drop crates and blow things up under a
// lossy, laggy network, a fourth player joins a third of the way in, and the
// desync counter has to stay at zero.
//
// fe-server uses this file as its default soak arena (DEFAULT_ARENA), so it
// must keep working with any number of bots and ticks. Bots spawn at x
// 120-162 and wander; the set pieces sit around them so that what they do
// reads as more than noise:
//   - a wooden hut over a gunpowder cellar, with a seam running from the
//     cellar to an oil puddle next to the spawn;
//   - a tall brick tower on an arch with two thin legs, right of the spawn,
//     so a single blast or dig between the legs frees it as one rigid body;
//   - two trees in the open middle ground, for stray fire to catch;
//   - a soil mesa with a stone cap, where a stack of crates is dropped next
//     to a bank packed with gunpowder;
//   - a water tank at the foot of a raised lava pit, the two split by a
//     3-cell stone wall, the lava's floor above the water.
// Scheduled events make sure every system is used even when the bots wander
// off. They come early, before the bots have wrecked the set pieces:
//   200   a blast cuts the tower legs: the tower tips over as one body (the
//         bots near the spawn often fell it first);
//   220   the oil puddle is heated until it burns; the fire runs down the
//         gunpowder seam, which chain-detonates into the cellar, throws the
//         hut and leaves its timber burning into smoke;
//   420   the top of the tank wall is blown off: lava cascades down onto the
//         water, crusts to obsidian and boils it to steam;
//   480   three wooden crates drop onto the mesa;
//   598   the gunpowder bank beside them goes off just as the late player
//         joins (tick 600 in the 1800-tick demo): the crates tumble through
//         the air into the tank, float, and catch fire where they drift onto
//         the lava;
//   1200  a second blast opens the rest of the wall and a second lava fall
//         pours into what is left of the water.
// In between and after, the bots dig, paint sand, water, oil, wood, lava and
// gunpowder, heat things, drop crates of their own and set off charges, so
// the trees and the ruins keep burning and collapsing.
[scene]
name = chaos soak
description = Four bots wreck a night-time arena over a lossy, laggy network: a brick tower falls as a rigid body, a burning oil puddle sets off a gunpowder seam that blows up a wooden hut, lava cascades into a water tank in steam and obsidian, a gunpowder blast throws crates tumbling into the water as a fourth player joins, and the desync counter stays at zero.
size = 512 288
seed = 0xc4a05
spawn = 120 150
ticks = 1800

[build]
fill 0 270 512 288 bedrock
terrain 0 512 222 3 64 soil 270
terrain 0 512 244 8 40 stone 270

// Wooden hut over a gunpowder cellar. A seam runs from the cellar to the
// right, under a small oil puddle next to the spawn.
fill 46 223 84 232 gunpowder
fill 84 224 108 227 gunpowder
fill 36 219 94 223 wood
fill 38 190 42 219 wood
fill 88 190 92 219 wood
fill 34 186 96 190 wood
fill 40 182 90 186 wood
fill 48 178 82 182 wood
fill 56 174 74 178 wood
fill 42 196 88 219 air
// Oil puddle in a shallow dip over the seam.
fill 97 217 115 224 air
fill 98 218 114 224 oil

// Tall brick tower on an arch with two thin legs, so one blast between them
// cuts both and the tower comes free as one body.
fill 182 192 185 222 brick
fill 193 192 196 222 brick
fill 176 186 202 192 brick
fill 178 112 200 186 brick
fill 183 124 195 134 glass
fill 183 146 195 156 glass
fill 183 168 195 178 glass
fill 174 106 204 112 brick

// Two trees in the middle ground.
fill 249 186 253 222 wood
circle 251 178 13 leaves
fill 300 196 303 222 wood
circle 301 188 10 leaves

// A soil mesa with a stone cap. Crates are dropped on the cap, next to a
// soil bank packed with gunpowder that blows them off towards the tank.
fill 318 200 370 224 soil
fill 322 188 366 200 soil
fill 324 180 362 188 soil
fill 324 175 361 180 stone
fill 324 163 334 175 soil
fill 328 167 331 171 gunpowder

// Water tank at the foot of a raised lava pit. A 3-cell stone wall separates
// them; the lava's floor is above the water, so a breach pours lava down
// onto it.
fill 368 196 449 242 stone
fill 372 196 449 238 air
fill 372 208 449 238 water
terrain 449 508 146 2 16 soil 242
fill 449 152 452 238 stone
fill 449 188 508 192 stone
fill 505 146 508 188 stone
fill 449 136 505 152 air
fill 452 146 505 188 air
fill 452 156 505 188 lava

// Light.
paint 65 212 1 torch
paint 370 188 1 torch

// Arena walls.
fill 0 0 4 270 bedrock
fill 508 0 512 270 bedrock

[events]
at 200: explode 189 210 12 220
every 2 from 220 to 260: heat 106 220 4 12
at 420: explode 450 164 12 200
at 480: body 336 152 348 164 wood
at 480: body 349 152 361 164 wood
at 480: body 342 138 354 150 wood
at 598: heat 329 169 5 250
at 1200: explode 450 182 10 200

[camera]
view 512 288
scale 2
sky night
ambient 0.3 0.3 0.4
exposure 1.3
at 0: 256 144
