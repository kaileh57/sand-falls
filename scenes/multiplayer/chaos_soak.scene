// Chaos soak: four bots wreck a night-time arena over a lossy, laggy network
// (150 ms, 2% loss), a fourth player joins a third of the way in, just as the
// tower falls, and the desync counter has to stay at zero. The HUD shows the
// world hash, per-player bandwidth and the total download graph, which stays
// flat however much the world is doing, because only inputs cross the network.
//
// fe-server uses this file as its default soak arena (DEFAULT_ARENA), so it
// must keep working with any number of bots and ticks. The world is 640x360
// at scale 3 (1920x1080), and the demo runs 2400 ticks: 40 s of real time at
// 60 ticks a second. Left to right:
//   - a wooden hut over a powder cellar with a TNT charge in it, and a
//     gunpowder seam running from the cellar to an oil puddle;
//   - open ground where players 0, 1 and 3 spawn, closed on the right by a
//     bedrock sea wall too high to jump. Bots aim at most 30 cells away and
//     blast 9 cells round, so from behind the wall they cannot reach the
//     tower's legs, its plinth or the pond, and the set pieces below happen
//     when the timeline says, whatever the bots do;
//   - a brick tower on two thin legs on a plinth at the pond's edge;
//   - a deep pond with a wooden hull floating on it in a thick oil slick;
//   - a tall rock cliff with a closed cistern of water near its top; player 2
//     spawns on the cliff behind a bedrock parapet.
// Scheduled events make sure every system is shown even if the bots wander:
//   40    the oil puddle is heated until it burns; the fire runs down the seam
//         into the cellar and the TNT goes up at about tick 170 as one merged
//         blast with a white flash, throwing the hut's roof as a burning body
//         and cooling sparks across the night sky; the crater walls glow;
//   250   two burning crates land at both ends of the slick: the fire runs
//         across the water from bank to bank and boils it into steam, and is
//         out by about tick 650;
//   840   the tower's legs are cut as the late player joins: it tips over
//         under real gravity, about 2 s from the cut to the splash, and sinks
//         in the pond, slopping water over the bank and rocking the hull;
//   1150  a hole is blown in the foot of the cistern wall: a pressurised jet
//         arcs into the pond, pushes the hull and falls off as the head drops,
//         until the cistern is empty;
//   1500  three wooden crates drop into the pond and float.
// In between and after, the bots dig, paint sand, water, oil, wood, lava and
// gunpowder, heat things, drop crates and set off charges.
[scene]
name = chaos soak
description = Four bots wreck a night-time arena over a 150 ms, 2% loss network: a TNT cellar throws a burning hut into the sky, a pressurised jet from a holed cistern arcs into a pond, a brick tower is felled into the water as a fourth player joins, and burning crates set the oil slick around a floating hull alight, while the hash, bandwidth and desync counter stay steady.
size = 640 360
seed = 0xc4a05
spawn = 128 212
spawn = 160 212
spawn = 616 88
spawn = 144 212
ticks = 2400

[build]
fill 0 340 640 360 bedrock
terrain 0 640 214 3 64 soil 340
terrain 0 640 236 8 40 stone 340

// Wooden hut over a powder cellar with a TNT charge in it. A gunpowder seam
// runs right, under an oil puddle next to the spawn.
fill 46 215 84 224 gunpowder
fill 58 217 70 221 tnt
fill 84 216 112 219 gunpowder
fill 36 211 94 215 wood
fill 38 182 42 211 wood
fill 88 182 92 211 wood
fill 34 178 96 182 wood
fill 40 174 90 178 wood
fill 48 170 82 174 wood
fill 56 166 74 170 wood
fill 42 188 88 211 air
fill 101 209 121 216 air
fill 102 210 120 216 oil

// A bedrock sea wall, too high to jump, keeps the players and their tools
// off the tower's plinth and out of the pond.
fill 180 188 184 240 bedrock

// Brick tower on the pond's left bank, on an arch with two thin legs set to
// the landward side, so that once it is cut free it can only fall pondward.
fill 227 184 229 215 brick
fill 233 184 235 215 brick
fill 226 178 254 184 brick
fill 230 112 252 178 brick
fill 235 120 247 130 glass
fill 235 140 247 150 glass
fill 235 160 247 170 glass
fill 226 106 256 112 brick

// Right bank: a tall rock cliff with a closed cistern of water near its top.
fill 500 90 636 340 stone
fill 500 66 505 90 bedrock
fill 508 108 570 170 air
fill 508 112 570 170 water

// Pond with a wooden boat on it.
fill 256 214 504 340 stone
fill 262 150 500 320 air
fill 262 244 500 320 water
fill 360 222 405 246 air
fill 360 240 405 246 wood
fill 360 228 364 240 wood
fill 401 228 405 240 wood
fill 382 212 384 240 wood
carve 360 212 405 246

// A thick oil slick floating on the pond, around the boat.
fill 266 236 358 244 oil
fill 407 236 500 244 oil

// Light.
paint 65 204 1 torch
paint 600 84 1 torch

// Arena walls.
fill 0 0 4 340 bedrock
fill 636 0 640 340 bedrock

[events]
// The hut's cellar: heat the oil puddle until it burns down the seam.
every 2 from 40 to 80: heat 118 212 4 12
// Two burning crates land on the slick, one at each end.
at 250: body 296 214 306 224 burning_wood
at 280: body 440 214 448 222 burning_wood
// The tower's legs, as the late player joins.
at 840: carve 222 100 260 211
at 840: dig 231 205 6
at 840: explode 252 208 12 250
// The cistern's hole: a pressurised jet into the pond.
at 1150: explode 500 163 5 250
at 1151: dig 504 163 7
at 1154: dig 504 163 7
// Crates drop into the pond and float.
at 1500: body 400 170 412 182 wood
at 1500: body 430 160 442 172 wood
at 1500: body 320 175 332 187 wood

[camera]
view 640 360
scale 3
sky night
ambient 0.3 0.3 0.4
exposure 1.3
at 0: 320 180

[expect]
// The cellar's TNT is there at the start and gone once the chain reaches it.
after 100: count tnt in 0 200 140 260 >= 40
after 400: count tnt in 0 200 140 260 == 0
after 400: count gunpowder in 0 200 140 260 == 0
// The slick burns on the water, across the pond, and boils it.
after 450: count burning_oil in 262 150 358 320 >= 20
after 450: count burning_oil in 407 150 500 320 >= 20
after 600: count steam in 262 0 500 260 >= 100
// The tower stands until the join and lies in the pond after it.
after 830: count brick in 220 100 260 200 >= 1400
after 1100: count brick in 220 100 260 200 == 0
after 1100: count brick in 262 214 500 320 >= 1000
// The cistern is full until the hole, the jet is in the air, and it drains.
after 1140: count water in 508 108 570 170 >= 3400
after 1300: drawn water in 400 140 500 240 >= 300
after 2399: count water in 508 108 570 170 <= 600
// Water stays out of the players' ground, and most of it is still water.
after 2399: count water in 0 150 180 260 <= 50
after 2399: count water in 0 0 640 340 >= 19000
