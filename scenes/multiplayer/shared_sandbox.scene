// Shared sandbox: eight players in one world of set pieces, each wired to a
// different system. Left to right: a pond on a thin stone cap over a lava
// pocket, sand dunes beside the spawn, a mill pond, a stone ridge over a
// gunpowder vein, a brick bridge over a flooded ravine, and a forest.
//
// The bots dig, paint, drop crates and blast near the spawn, so the dunes and
// the ponds are theirs to set off. The world also has its own timeline, which
// is scene data that every peer runs, so it costs no bandwidth either:
//   tick 720   the vein is lit; it chains under the ridge to two charges
//              and the ridge comes apart
//   tick 1200  the charges at the bridge piers go off; the deck drops into
//              the pool
//   tick 1500  a charge at the forest's edge goes off and the forest burns
//   tick 1800  unless a player got there first, the lava cap is cracked and
//              the pond drains onto the lava
// Only inputs cross the network, so the bandwidth graph stays flat while the
// screen fills with chaos.
//
// There is no water tower: a body carrying liquid in its own hollow is lifted
// by that liquid and floats up instead of falling, so a tank on stilts cannot
// fall and splash until the engine fixes that.
[scene]
name = shared sandbox
description = Eight players dig into sand dunes and ponds over lava while charges chain through a ridge, a brick bridge and a forest; bandwidth stays flat because only inputs cross the network.
size = 768 432
// The seed only shifts terrain noise and the undergrowth. With the review
// settings (8 bots, 1% loss, network seed 1) about half of all seeds leave one
// bot stuck joining, because a lost join packet is never resent; this one
// lets all eight in. Recheck with fe-server soak after editing the build.
seed = 0x5a55
spawn = 200 220

[build]
// Trees go in before the ground so the soil cuts each trunk at the surface.
fill 606 226 610 272 wood
circle 608 222 11 leaves
circle 600 230 7 leaves
circle 616 229 7 leaves
fill 632 212 636 272 wood
circle 634 208 14 leaves
circle 623 216 9 leaves
circle 645 215 9 leaves
fill 657 228 660 272 wood
circle 658 224 10 leaves
circle 651 232 6 leaves
circle 665 231 6 leaves
fill 682 214 686 272 wood
circle 684 210 14 leaves
circle 673 218 9 leaves
circle 695 217 9 leaves
fill 708 226 712 272 wood
circle 710 222 11 leaves
circle 701 230 7 leaves
circle 719 229 7 leaves

// Ground: soil over stone over bedrock.
fill 0 380 768 432 bedrock
terrain 0 768 262 3 64 soil 380
terrain 0 768 288 6 48 stone 380
fill 0 0 4 380 bedrock
fill 764 0 768 380 bedrock

// 1. A pond on a thin stone cap over a lava pocket. There is more water than
// lava, so when the cap breaks the water boils on the lava and crusts it over
// as obsidian instead of the lava flooding the surface.
fill 26 258 114 300 stone
fill 32 258 108 284 water
fill 48 289 92 296 lava
circle 60 300 9 lava
circle 80 300 9 lava
circle 70 304 9 lava

// 2. Sand dunes right of the pond, beside the spawn, at their angle of rest.
fill 118 254 182 264 sand
fill 124 244 176 254 sand
fill 130 234 168 244 sand
fill 137 225 160 234 sand
fill 143 217 154 225 sand

// 3. A mill pond beside the spawn, for crates and players to fall into and
// for painted lava to quench in.
fill 264 256 336 280 stone
fill 268 256 332 276 water

// 4. Stone ridge over a buried gunpowder vein with two TNT charges in it.
// The vein stays under the ridge, so stray blasts near the spawn rarely
// reach it before its tick.
fill 356 252 424 262 stone
fill 362 242 418 252 stone
fill 368 232 412 242 stone
fill 375 224 405 232 stone
fill 382 218 398 224 stone
fill 358 266 418 270 gunpowder
fill 374 258 382 270 tnt
fill 398 258 406 270 tnt

// 5. Brick bridge over a ravine with a pool. The deck clears both banks and
// stands on two piers founded on the ravine floor, so cutting the piers drops
// it into the pool.
fill 459 240 580 262 air
fill 459 262 466 266 soil
fill 569 262 580 266 soil
fill 466 262 569 380 air
fill 466 320 569 380 stone
fill 466 296 569 320 water
fill 469 262 566 272 brick
fill 490 272 497 320 brick
fill 538 272 545 320 brick

// 6. A forest across the ravine, with a TNT charge at the edge of it.
fill 596 258 604 268 tnt
decorate 590 200 740 266 leaves 30 floor

[events]
// The vein is lit at its left end.
every 2 from 720 to 740: heat 360 268 4 20
// Charges cut the left pier, then the right one a quarter second later. The
// explosions do not break brick under water, so the submerged foot of each
// pier is cut away in the same tick.
at 1200: explode 493 280 8 220
at 1200: explode 493 292 7 200
at 1200: dig 493 304 6
at 1200: dig 493 315 6
at 1215: explode 541 280 8 220
at 1215: explode 541 292 7 200
at 1215: dig 541 304 6
at 1215: dig 541 315 6
// The charge at the forest's edge goes off and the trees catch.
every 1 from 1500 to 1506: heat 600 263 6 60
// Backstop for the lava moment if no player has broken the cap yet.
at 1800: explode 70 286 7 160
at 1800: dig 70 288 9

[camera]
view 960 540
scale 2
sky day
ambient 0.25 0.25 0.28
at 0: 384 216 zoom=1.25
