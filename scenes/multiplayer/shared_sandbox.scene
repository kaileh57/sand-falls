// Shared sandbox: eight players on a bridge over a quarry. Their digging,
// painting, crates and blasts are the chaos; a timeline of scene events that
// every peer runs, so it costs no bandwidth either, brings the water:
//   0     the players spawn on a grated bridge between a reservoir pool and a
//         lake with a boat on it; whatever they paint or drop through the
//         grating lands in the pit under it, where lava, oil and gunpowder
//         burn and blow up
//   360   a sluice opens low in the reservoir gate and a jet arcs into the
//         pool; the culvert under the pit carries the water on to the lake,
//         which rises under the boat
//   900   crates tumble into the lake and float beside the boat
//   1500  charges blow the gate away; the 118-row column of water collapses,
//         a wave runs into the bridge, through the culvert and rocks the boat
// Only inputs cross the network, so the bandwidth graph stays flat while the
// screen fills with chaos.
//
// The chaos bots dig away any liquid they can reach, and their blasts throw
// it into the sky as spray, so every pool here stays more than 24 cells below
// the deck, out of their reach, and the pit keeps what they drop (gunpowder
// and lava above all) out of the water. The walls at the ends of the bridge
// are taller than a jump, so the bots stay on the bridge and in frame. The grating lets the sky light under the
// deck; a solid deck would cast a dark slab over the pit.
[scene]
name = shared sandbox
description = Eight players on a grated bridge over a quarry dig, paint, drop crates and blast while a sluice jet fills the pool, crates float by a boat on the lake, and the reservoir gate is blown away so the flood surges under them; bandwidth stays flat because only inputs cross the network.
size = 512 288
seed = 0x5a55
spawn = 196 164
spawn = 356 164
spawn = 220 164
spawn = 332 164
spawn = 244 164
spawn = 308 164
spawn = 262 164
spawn = 288 164

[build]
fill 0 268 512 288 bedrock

// The reservoir, held by a concrete gate that stands on the quarry floor. A
// bedrock course carries the gate above its sluice.
fill 0 150 110 268 water
fill 110 120 124 268 concrete
fill 110 216 124 228 bedrock

// A pool at the foot of the gate and a lake with a stone bank on the right,
// joined by a culvert under the bridge.
fill 490 150 512 268 stone
terrain 486 512 150 3 20 soil 170
fill 124 244 490 268 water
terrain 124 490 264 2 20 sand 268

// The bridge: a bedrock grating over a pit that catches whatever the players
// drop through it, walled at both ends. The culvert runs under the pit floor.
fill 180 170 370 174 bedrock
fill 180 130 186 244 bedrock
fill 364 130 370 244 bedrock
fill 186 238 364 244 bedrock
fill 190 170 192 174 air
fill 196 170 198 174 air
fill 202 170 204 174 air
fill 208 170 210 174 air
fill 214 170 216 174 air
fill 220 170 222 174 air
fill 226 170 228 174 air
fill 232 170 234 174 air
fill 238 170 240 174 air
fill 244 170 246 174 air
fill 250 170 252 174 air
fill 256 170 258 174 air
fill 262 170 264 174 air
fill 268 170 270 174 air
fill 274 170 276 174 air
fill 280 170 282 174 air
fill 286 170 288 174 air
fill 292 170 294 174 air
fill 298 170 300 174 air
fill 304 170 306 174 air
fill 310 170 312 174 air
fill 316 170 318 174 air
fill 322 170 324 174 air
fill 328 170 330 174 air
fill 334 170 336 174 air
fill 340 170 342 174 air
fill 346 170 348 174 air
fill 352 170 354 174 air
fill 358 170 360 174 air

[build]
// The boat and the logs.
fill 402 236 470 240 wood
fill 402 224 406 236 wood
fill 466 224 470 236 wood
carve 402 224 470 240
body 206 166 236 170 wood
body 300 166 324 170 wood

[events]
// The sluice opens.
at 360: fill 110 220 124 224 air
// Crates tumble into the lake beside the boat.
at 900: body 384 120 396 132 wood
at 960: body 440 110 452 122 wood
at 1020: body 476 120 488 132 wood
// Charges along the gate's dry face go off and blow it away.
at 1500: explode 127 130 7 160
at 1500: explode 127 160 7 160
at 1500: explode 127 190 7 160
at 1500: explode 127 220 7 160
at 1501: fill 110 120 124 268 air

[camera]
// On the bridge, the pool and the lake, then wider for the flood.
view 960 540
scale 2
sky day
ambient 0.25 0.25 0.28
at 0: 290 170 zoom=2.2
at 180: 300 172 zoom=2.4
at 1440: 300 172 zoom=2.4
at 1495: 268 168 zoom=2.2
at 2400: 268 168 zoom=2.2

[expect]
// Run without players: the reservoir is full until the gate goes, the jet
// fills the pool and, through the culvert, raises the lake, the boat, logs
// and crates are bodies, and the flood drains the reservoir into the lake.
after 300: count water in 0 120 110 268 > 12000
after 1400: count water in 124 120 180 268 > 2000
after 1400: count water in 370 120 490 268 > 3500
after 1600: bodies >= 5
after 2400: count water in 0 120 110 268 < 8000
after 2400: count water in 370 120 490 268 > 5000
