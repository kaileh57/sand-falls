// Shared sandbox: eight players in one sandpit under a reservoir. Their
// digging, painting, crates and blasts are the chaos; a timeline of scene
// events that every peer runs, so it costs no bandwidth either, keeps the
// water coming at them:
//   0     the players spawn across the sandpit, two of them on a raft on the
//         pond, which rocks and drifts as they dig, jump and blast on it
//   540   the middle sluice of the dam opens: a jet arcs out of the concrete
//         at the speed its head gives it and lands among the players
//   1200  the bottom sluice opens under it, a second, flatter jet
//   1450  five wooden crates drop into the flooded pit and float
//   1850  a charge in the dam goes off; the dam above it topples as one
//         body and the rest of the reservoir spills over the rubble
// Only inputs cross the network, so the bandwidth graph stays flat while the
// screen fills with chaos.
//
// The chaos bots dig for 20 ticks at a time and their dig removes liquid as
// well as solid cells, so the pond is mostly dug away in the first ten
// seconds; the sluices keep feeding the pit after that. Bedrock lies 36
// cells under the sand so that the pit holds its water and the bots cannot
// drill the world away.
[scene]
name = shared sandbox
description = Eight players dig, paint and blast in a sandpit under a reservoir: sluice jets arc into the pit, a raft and dropped crates float on the flood, and a charge topples the dam; bandwidth stays flat because only inputs cross the network.
size = 640 300
// With the review settings (8 bots, 1% loss, network seed 1) some seeds
// leave one bot stuck joining, because a lost join packet is never resent.
// Recheck with fe-server soak after editing the build.
seed = 0x5a55
spawn = 214 246
spawn = 300 246
spawn = 246 250
spawn = 336 246
spawn = 380 250
spawn = 420 246
spawn = 188 236
spawn = 456 240

[build]
// Bedrock under a skin of sand, soil and stone, so the players can wreck the
// surface but cannot drill the world away.
fill 0 292 640 300 bedrock
terrain 0 640 256 3 40 sand 292

// Left mountain with the reservoir and its dam on top.
circle 110 297 110 soil
circle 110 302 110 stone
fill 0 192 110 292 stone
terrain 0 124 186 1 30 sand 192
fill 0 100 124 188 water
fill 124 90 140 204 concrete
fill 140 122 146 204 concrete
fill 146 154 152 204 concrete
// Bedrock courses anchor the dam above its sluices, so cutting a sluice
// does not drop the top of the dam into the hole as a rigid body.
fill 124 90 140 92 bedrock
fill 124 166 152 168 bedrock
// A charge in the dam, for the finale.
fill 124 169 132 177 tnt

// Right hill.
circle 540 302 90 soil
circle 540 307 90 stone
terrain 540 640 212 4 50 soil 292
terrain 540 640 222 6 40 stone 292

// A pond in the middle of the sandpit.
fill 262 246 392 290 air
fill 262 250 392 290 water
circle 262 286 18 sand
circle 392 286 18 sand

// Trees and brush.
fill 580 164 584 214 wood
circle 582 160 11 leaves
circle 573 168 7 leaves
circle 591 167 7 leaves
fill 616 172 619 214 wood
circle 617 168 9 leaves
circle 610 175 6 leaves
decorate 480 180 636 218 leaves 25 floor
decorate 150 190 200 250 leaves 20 floor

[build]
// A raft on the pond, and three logs on the sand.
body 292 244 360 249 wood
body 420 246 454 249 wood
body 424 242 446 245 wood
body 416 238 436 241 wood

[events]
// The middle sluice opens.
at 540: fill 120 154 154 162 air
// The bottom sluice opens.
at 1200: fill 120 178 156 186 air
// Crates tumble into the flooded pit.
at 1450: body 236 60 248 72 wood
at 1480: body 300 50 312 62 wood
at 1510: body 268 40 280 52 wood
at 1540: body 340 60 352 72 wood
at 1570: body 210 50 222 62 wood
// The charge in the dam goes off. Its bedrock courses turn to concrete first,
// so the dam above the charge is no longer anchored and topples as a body.
at 1850: fill 124 90 140 92 concrete
at 1850: fill 124 166 152 168 concrete
at 1850: heat 128 173 6 200

[camera]
// Wide on the pit, in on the first jet, wide for the crates, in on the dam
// for the finale.
view 960 540
scale 2
sky day
ambient 0.25 0.25 0.28
at 0: 266 150 zoom=1.8
at 440: 266 150 zoom=1.8
at 600: 236 178 zoom=2.3
at 920: 246 178 zoom=2.3
at 1100: 266 150 zoom=1.8
at 1780: 266 150 zoom=1.8
at 1900: 240 170 zoom=2.1
at 2150: 250 170 zoom=2.1
at 2350: 266 150 zoom=1.8

[expect]
// Run without players: the reservoir is full until the first sluice, the
// jets fill the pit, the crates make bodies, the charge goes off and the
// reservoir has drained by more than half at the end.
after 500: count water in 0 90 124 188 > 10000
after 800: count water in 150 120 640 292 > 5500
after 1300: count water in 150 120 640 292 > 8000
after 1600: bodies >= 9
after 2000: count tnt in 120 160 160 190 == 0
after 2400: count water in 0 90 124 188 < 6000
